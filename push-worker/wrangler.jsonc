{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-diary-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "triggers": {
    "crons": ["*/2 0-15,22-23 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "REMINDERS",
      "id": "9047c8ccd6d34bfdace760bc64c9a20d"
    }
  ]
}
