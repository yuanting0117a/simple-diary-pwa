{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-diary-push",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "REMINDERS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
